{
  "name": "bountylens",
  "version": "0.1.0",
  "description": "Chrome side-panel extension for finding public GitHub issues with the exact bounty label.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "rowenapinto001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowenapinto001/BountyLens.git"
  },
  "bugs": {
    "url": "https://github.com/rowenapinto001/BountyLens/issues"
  },
  "homepage": "https://github.com/rowenapinto001/BountyLens#readme",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "github",
    "bounty",
    "side-panel",
    "react",
    "typescript",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
